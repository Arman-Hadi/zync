{
  "name": "zync",
  "version": "0.1.0",
  "description": "Two-way Obsidian vault sync over S3-compatible storage (desktop + mobile)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "sync",
    "s3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.1",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
