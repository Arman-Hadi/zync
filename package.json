{
  "name": "zync",
  "version": "1.1.2",
  "description": "Two-way Obsidian vault sync over S3-compatible storage (desktop + mobile)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "sync",
    "s3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
